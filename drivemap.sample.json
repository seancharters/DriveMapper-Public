{
  "schemaVersion": 1,

  // Bump this whenever you change mappings. It is stamped into
  // HKLM\SOFTWARE\DriveMapper\ConfigVersion on import, which is what lets Intune detect
  // which configuration a device has.
  "configVersion": "2026.08.21.1",

  "entra": {
    "tenantId": "00000000-0000-0000-0000-000000000000",
    "clientId": "00000000-0000-0000-0000-000000000000",

    // graphApplication (recommended for a mixed hybrid / cloud-only fleet)
    //     The SERVICE looks groups up in Graph with APPLICATION permissions and a client
    //     credential only it can read, then hands the agent a finished plan. Needs no
    //     Primary Refresh Token, no broker and no per-user consent, so hybrid and
    //     cloud-only devices behave identically. Store the secret with:
    //         DriveMapper.Service.exe --set-secret        (elevated)
    //     or set certificateThumbprint below and skip the secret entirely.
    //
    // windowsToken
    //     Group SIDs straight from the Windows logon token. No network, no app
    //     registration, works offline. Only sees local and on-premises AD groups —
    //     cloud-only Entra groups NEVER appear. Match on groupSid or groupName.
    //
    // auto            Windows token first, then delegated Entra; results merged.
    // claimsThenGraph Delegated: token 'groups' claim, Graph as fallback.
    // claimsOnly      Delegated: token claim only.
    // graphOnly       Delegated: always Graph.
    //
    // The delegated modes require the signed-in user to be able to mint a token on the
    // device. That fails on a domain-joined machine with no PRT — the common cause of
    // "Silent token acquisition needs user interaction".
    "groupSource": "graphApplication",

    "useTransitiveGroups": true,

    // Optional: certificate in LocalMachine\My. Preferred over a client secret.
    // "certificateThumbprint": "A1B2C3...",

    // Optional: where the encrypted secret lives. Defaults to
    // C:\ProgramData\DriveMapper\secret.dat (SYSTEM + Administrators only).
    // "secretFile": "C:\\ProgramData\\DriveMapper\\secret.dat",

    // Troubleshooting only — writes usernames and token metadata to the log.
    "enablePiiLogging": false
  },

  "options": {
    "removeUnmatchedDrives": true,
    "persistent": false,
    "recheckIntervalMinutes": 60,
    "groupCacheMaxAgeHours": 336,
    "logRetentionDays": 30,

    // Notification-area icon giving users "Map drives now" and a personal sync interval.
    // Their choice affects only their own session; the schedule above stays authoritative.
    "trayIcon": true,
    "minimumUserIntervalMinutes": 5
  },

  "mappings": [
    {
      "driveLetter": "S",
      "uncPath": "\\\\fs01.contoso.com\\shared",
      "label": "Company Shared",
      "allUsers": true
    },
    {
      "driveLetter": "F",
      "uncPath": "\\\\fs01.contoso.com\\finance",
      "label": "Finance",
      "groupId": "11111111-1111-1111-1111-111111111111",
      "groupName": "SG-Drive-Finance"
    }
  ]
}
